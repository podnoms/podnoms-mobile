<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Lists PodNoms as a media app in Android Auto. -->
    <meta-data
      android:name="com.google.android.gms.car.application"
      android:resource="@xml/automotive_app_desc" />

    <service
      android:name="expo.modules.podnomsauto.AutoLibraryService"
      android:exported="true"
      android:foregroundServiceType="mediaPlayback">
      <intent-filter>
        <action android:name="androidx.media3.session.MediaLibraryService" />
        <action android:name="android.media.browse.MediaBrowserService" />
      </intent-filter>
    </service>

    <!-- Artwork for the car's lists, which can't load https images itself. -->
    <provider
      android:name="expo.modules.podnomsauto.AutoArtworkProvider"
      android:authorities="${applicationId}.auto.artwork"
      android:exported="true" />
  </application>
</manifest>
