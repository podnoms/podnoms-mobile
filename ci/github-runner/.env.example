# A fine-grained token for podnoms/podnoms-mobile with
# "Administration: Read and write" (to fetch the runner's registration token).
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
# Where the runner keeps its install, caches and work dir (not under /srv/dev,
# which is synced). Create the subfolders as your user before the first `up`.
RUNNER_DATA=/srv/wasp-dev/working/github-workers/podnoms-mobile
